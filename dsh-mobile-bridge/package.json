{
  "name": "dsh-mobile-bridge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Serve this DeepSeek Harness to the DSH Mobile iOS app over LAN HTTP and Server-Sent Events.",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "bridge.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
